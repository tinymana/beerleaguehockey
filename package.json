{
  "name": "beer-league-hockey",
  "version": "0.2.1",
  "private": true,
  "description": "Beer League Hockey - a recreational hockey universe by Tiny Mana Studios",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "preview:site": "vite preview --outDir dist-site",
    "assets:ingest": "python3 scripts/art/ingest_arena.py"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
